.join-via-qr .home-preview,
.join-via-qr .home-foot,
.join-via-qr .home-links,
.join-via-qr .field--code { display: none; }
.room-chip { display: none; margin: 0 0 0.5rem; text-align: center; }
.join-via-qr .room-chip {
  display: block; font-family: var(--font-display); letter-spacing: 0.25em;
  font-size: 1.5rem; color: var(--vert);
  text-shadow: 0 0 20px rgba(0,228,114,0.45);
}

/* -------- accueil -------- */
#pHome .brand--phone { display: none; }
.home-hero { text-align: center; padding: 1.1rem 0 0.4rem; }
.hero-logo {
  font-family: var(--font-display);
  font-size: clamp(2.7rem, 12vw, 3.8rem);
  letter-spacing: 0.03em;
  line-height: 1;
  text-shadow: 0 0 40px rgba(46,133,255,0.35);
}
.hero-logo span { color: var(--vert); }
.hero-sub {
  font-family: var(--font-display);
  letter-spacing: 0.38em;
  font-size: 0.62rem;
  color: var(--bleu2);
  margin: 0.5rem 0 0.9rem;
}
.hero-tagline { color: rgba(244,246,252,0.62); font-size: 0.82rem; line-height: 1.45; }
.home-card { display: flex; flex-direction: column; gap: 0.7rem; }
.home-links { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; margin-top: 0.3rem; }
.home-preview {
  align-self: center;
  width: 116px; height: 150px;
  margin: 0.3rem 0 0.1rem;
  border-radius: var(--r-lg);
  background: radial-gradient(circle at 50% 40%, rgba(46,133,255,0.22), transparent 70%);
  position: relative;
}
.home-preview svg { width: 100%; height: 100%; }
.home-foot {
  margin-top: auto; text-align: center;
  font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(244,246,252,0.3);
}

/* -------- personnage -------- */
.avatar-head { display: flex; align-items: center; gap: 0.6rem; }
.avatar-head h2 { font-size: 1.35rem; flex: 1; }
.avatar-head .hint { margin-top: 0.1rem; }
.avatar-preview-wrap {
  display: flex; flex-direction: column; align-items: center;
  background: radial-gradient(ellipse at 50% 30%, rgba(46,133,255,0.22), transparent 68%);
  border-radius: var(--r-xl);
  padding: 0.4rem 0 0.6rem;
}
.avatar-preview { width: 170px; height: 215px; }
.avatar-preview svg { width: 100%; height: 100%; }
.avatar-name { font-family: var(--font-display); font-size: 1.05rem; }
.avatar-badge {
  margin-top: 0.2rem; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--vert);
}
.avatar-scroll { display: flex; flex-direction: column; gap: 0.9rem; }
.avatar-group { background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-lg); padding: 0.7rem; }
.group-title {
  font-family: var(--font-display); font-size: 0.68rem; letter-spacing: 0.16em;
  text-transform: uppercase; color: rgba(244,246,252,0.55); margin-bottom: 0.5rem;
}
.choice-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.35rem; }
.choice {
  min-height: 44px; border-radius: var(--r-md);
  background: rgba(255,255,255,0.06);
  border: 2px solid transparent;
  font-size: 0.7rem; line-height: 1.1;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem;
  padding: 0.35rem 0.2rem;
  color: rgba(244,246,252,0.8);
  transition: border-color var(--trans-fast), background var(--trans-fast), transform var(--trans-fast);
}
.choice:hover { background: rgba(255,255,255,0.1); }
.choice:active { transform: scale(0.96); }
.choice.on { border-color: var(--vert); background: rgba(0,228,114,0.14); color: #fff; }
.choice .choice-ico { font-size: 1rem; }
.color-block { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.45rem; }
.color-block > span { width: 92px; flex: none; font-size: 0.68rem; color: rgba(244,246,252,0.6); }
.color-row { display: flex; flex-wrap: wrap; gap: 0.35rem; }
.color-dot {
  width: 30px; height: 30px; border-radius: 50%;
  border: 3px solid transparent;
  outline: 1px solid rgba(255,255,255,0.18);
  transition: transform var(--trans-fast), border-color var(--trans-fast);
}
.color-dot.on { border-color: #fff; transform: scale(1.12); }
.sticky-bottom { position: sticky; bottom: 0; z-index: 5; box-shadow: 0 -12px 28px rgba(6,13,42,0.9); }

/* -------- lobby joueur -------- */
.phone .panel { background: rgba(12,26,75,0.55); }
.lobby-preview { display: flex; justify-content: center; margin: 0.6rem 0 1rem; }
.lobby-preview .avatar-preview { width: 150px; height: 190px; }
.lobby-preview .avatar-preview svg { width: 100%; height: 100%; display: block; }
.h2-sm { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(244,246,252,0.55); margin-top: 0.4rem; }
.lobby-list { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.5rem 0 0.8rem; min-height: 30px; }
.lobby-list .lobby-player { font-size: 0.76rem; }
.lobby-list .lobby-player.me { border-color: rgba(0,228,114,0.6); background: rgba(0,228,114,0.1); }
.phone .code-big { text-align: center; margin-bottom: 0.2rem; }

/* -------- jeu -------- */
#pGame { gap: 0.6rem; }
.game-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
.game-round { font-family: var(--font-display); font-size: 0.68rem; letter-spacing: 0.16em; color: var(--vert); }
.game-timer { display: flex; align-items: center; gap: 0.25rem; }
.game-timer img { width: 20px; height: 20px; opacity: 0.8; }
.game-timer span { font-family: var(--font-display); font-size: 1.5rem; }
.game-timer span.low { color: var(--orange); animation: pulse 0.9s infinite; }
.game-score { font-family: var(--font-display); font-size: 0.82rem; color: rgba(244,246,252,0.75); }
.game-score span { color: var(--gold); font-size: 1.15rem; }
.game-question {
  font-family: var(--font-question);
  font-size: clamp(1.15rem, 5.4vw, 1.55rem);
  line-height: 1.2;
  padding: 0.8rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-left: 4px solid var(--bleu2);
  border-radius: var(--r-md);
}
.game-strikes { display: flex; gap: 0.4rem; justify-content: center; }
.game-strikes .strike-x { width: 30px; height: 30px; font-size: 1rem; }
.game-status {
  text-align: center;
  font-family: var(--font-display);
  font-size: 0.88rem;
  letter-spacing: 0.04em;
  color: rgba(244,246,252,0.72);
  min-height: 1.4rem;
}
.game-status.you { color: var(--vert); text-shadow: 0 0 18px rgba(0,228,114,0.4); }
.game-status.steal { color: var(--gold); text-shadow: 0 0 18px rgba(255,207,90,0.4); }

.buzz-btn {
  align-self: center;
  width: min(58vw, 230px); aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 30%, #ff8a5c, var(--orange) 48%, #b4270a 100%);
  border: 6px solid rgba(255,255,255,0.18);
  box-shadow: 0 14px 44px rgba(255,78,32,0.5), inset 0 -10px 0 rgba(0,0,0,0.2);
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 6vw, 1.9rem);
  letter-spacing: 0.08em;
  color: #fff;
  text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  animation: buzzPulse 1.6s infinite;
}
.buzz-btn:active { transform: scale(0.95); }
@keyframes buzzPulse {
  0%, 100% { box-shadow: 0 14px 44px rgba(255,78,32,0.45), inset 0 -10px 0 rgba(0,0,0,0.2); }
  50% { box-shadow: 0 14px 60px rgba(255,78,32,0.75), 0 0 0 12px rgba(255,78,32,0.09), inset 0 -10px 0 rgba(0,0,0,0.2); }
}
.answer-box { display: flex; gap: 0.45rem; margin-top: auto; }
.answer-send--ghost { background: rgba(255,255,255,0.12); color: #fff; }
.spectator-box { gap: 0.45rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 0.5rem; margin-top: 0.4rem; }
.spectator-label { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(244,246,252,0.55); flex: none; }
.spectator-line { font-size: 0.78rem; text-align: center; color: var(--gold); letter-spacing: 0.04em; min-height: 1.2rem; margin-top: 0.3rem; }
.answer-input {
  flex: 1; min-height: 56px;
  padding: 0.7rem 1rem;
  border-radius: var(--r-md);
  border: 2px solid rgba(255,255,255,0.16);
  background: rgba(5,11,38,0.7);
  color: var(--blanc);
  font-size: 1.05rem;
}
.answer-input:focus { border-color: var(--vert); }
.answer-input:disabled { opacity: 0.42; }
.answer-send {
  width: 64px; flex: none; border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--vert), #00b458);
  color: var(--nuit-fonce);
  font-family: var(--font-display);
  font-size: 1rem;
  box-shadow: 0 6px 18px rgba(0,228,114,0.3);
}
.answer-send[disabled] { opacity: 0.35; box-shadow: none; }
.found-list { display: flex; flex-wrap: wrap; gap: 0.3rem; min-height: 1.5rem; }
.found-list span {
  background: rgba(0,228,114,0.14);
  border: 1px solid rgba(0,228,114,0.45);
  color: #b8ffd9;
  border-radius: var(--r-full);
  padding: 0.22rem 0.55rem;
  font-size: 0.7rem;
  animation: popIn 0.3s cubic-bezier(0.2, 1.5, 0.5, 1);
}
.found-list span.missed {
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.15);
  color: rgba(244,246,252,0.5);
}
@keyframes popIn { from { transform: scale(0.5); opacity: 0; } }
.pot-line { text-align: center; font-size: 0.8rem; color: rgba(244,246,252,0.7); }
.pot-line b { color: var(--gold); font-family: var(--font-display); font-size: 1.1rem; }

/* -------- fin / classement -------- */
#pEnd .panel, #pLeaderboard .panel { margin-top: 0.4rem; }
#pLeaderboard .rank-list { max-height: 62vh; }

/* =====================================================================
   ADAPTATIF
   ===================================================================== */
@media (max-width: 900px) {
  .host-top { padding: 0.7rem 0.8rem; }
  .brand-sub { display: none; }
  .brand-name { font-size: 1.15rem; }
  .host-banner { top: 4rem; }
  .board { width: 88vw; }
  .host-lower { flex-wrap: wrap; padding: 0.6rem 0.8rem calc(0.6rem + env(safe-area-inset-bottom)); }
  .host-scoreboard { order: 1; flex-basis: 100%; max-height: 86px; }
  .host-controls { order: 2; flex: 1; max-width: none; }
  .host-timer { order: 3; min-width: 72px; }
  .host-strikes { top: auto; bottom: 150px; right: 0.8rem; }
  .host-controls .btn { min-height: 38px; font-size: 0.72rem; padding: 0.45rem 0.7rem; }
  .wrong-banner { bottom: 150px; width: 88vw; }
}

@media (max-height: 720px) and (min-width: 701px) {
  .host-lower { padding: 0.4rem 1rem calc(0.6rem + env(safe-area-inset-bottom)); max-height: 68vh; }
  .host-controls .btn { min-height: 40px; font-size: 0.72rem; padding: 0.45rem 0.7rem; }
  #btnHostMain { min-height: 44px; font-size: 0.8rem; padding: 0.55rem 1rem; }
  .host-banner { top: 2.8rem; }
  .board { top: 20%; }
}

/* téléphone en paysage */
@media (max-height: 520px) and (max-width: 900px) {
  .home-hero { display: none; }
  .phone-main { overflow-y: auto; }
  .screen { min-height: auto; }
}

/* petits téléphones portrait : réduire l'accueil pour tout voir sans scroller */
@media (max-width: 480px), (max-height: 700px) {
  .home-preview { display: none; }
  .home-card { gap: 0.5rem; }
  .field { gap: 0.3rem; }
  .input { min-height: 48px; padding: 0.75rem 1rem; font-size: 1rem; }
  .input--code { font-size: 1.25rem; }
  .btn--xl { min-height: 52px; font-size: 1rem; padding: 0.85rem 1.4rem; }
  .home-links { gap: 0.2rem; margin-top: 0.1rem; }
  .home-foot { display: none; }
}

/* ===================== Bannière mode démo ===================== */
.demo-banner {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.5rem 1rem;
  background: rgba(255, 78, 32, 0.95);
  color: #fff; font-size: 0.85rem; letter-spacing: 0.08em;
  box-shadow: 0 4px 12px rgba(255, 78, 32, 0.3);
}
.demo-banner.hidden { display: none !important; }
.demo-banner-content { display: flex; align-items: center; gap: 1rem; flex: 1; }
.demo-badge {
  display: inline-block; font-family: var(--font-display); font-size: 0.75rem;
  letter-spacing: 0.2em; text-transform: uppercase; color: #00E472;
  border: 1px solid #00E472; padding: 0.15rem 0.5rem; border-radius: 4px;
}
.demo-label { flex: 1; color: rgba(255,255,255,0.95); }
.btn--demo { color: var(--bleu2); }
.btn--sm { min-height: 34px; font-size: 0.75rem; padding: 0.35rem 0.7rem; }


===== ./css/style.css =====

/* =====================================================================
   CREATOR — Guess Their Answer
   Palette : #0B35FE #FF4E20 #00E472 #FF7A00 #2E85FF #0C1A4B #F4F6FC
   ===================================================================== */
@font-face { font-family: 'Famous College'; src: url('../assets/fonts/famous-college.ttf') format('truetype'); font-display: swap; }
@font-face { font-family: 'Granika'; src: url('../assets/fonts/granika.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Janda'; src: url('../assets/fonts/janda-manatee-solid.ttf') format('truetype'); font-display: swap; }
@font-face { font-family: 'DS-Digi'; src: url('../assets/fonts/janda-manatee-solid.ttf') format('truetype'); font-display: swap; }

:root{
  --blue:#0B35FE; --navy:#0C1A4B; --green:#00E472; --coral:#FF4E20; --coral-h:#E63C10;
  --orange:#FF7A00; --light:#2E85FF; --bg:#F4F6FC; --white:#fff; --gold:#ffcf5a;
  --glass:rgba(12,26,75,.86); --safe-b:env(safe-area-inset-bottom,0px); --safe-t:env(safe-area-inset-top,0px);
  --shadow:0 24px 60px rgba(3,8,35,.5);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;background:#050B26;color:var(--white);
  font-family:Janda,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.hidden{display:none!important}
button{font-family:inherit;cursor:pointer;border:0}
img{user-select:none;-webkit-user-drag:none}

/* ============================ CANVAS ============================ */
#scene{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0}

/* ============================ LOADER ============================ */
#loader{position:fixed;inset:0;z-index:200;display:grid;place-items:center;
  background:radial-gradient(circle at 50% 30%,#12245e,#050B26 70%);transition:opacity .5s}
#loader.done{opacity:0;pointer-events:none}
.loader-card{text-align:center;width:min(84vw,420px)}
.loader-logo{font-family:'Famous College',serif;font-size:clamp(42px,9vw,74px);letter-spacing:2px;line-height:1}
.loader-logo span{color:var(--green)}
.loader-sub{font-family:'Granika';letter-spacing:6px;font-size:clamp(11px,2.4vw,15px);color:var(--light);margin:6px 0 26px}
.loader-bar{height:10px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden}
.loader-bar i{display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,var(--green),var(--light));transition:width .25s}
#loaderTxt{margin-top:12px;font-size:13px;opacity:.7}

/* ============================ HUD HÔTE ============================ */
#hostHud{position:fixed;inset:0;z-index:5;display:flex;flex-direction:column;justify-content:space-between}
#hostTop{display:flex;gap:10px;align-items:center;padding:calc(12px + var(--safe-t)) 16px 0}
.chip{display:inline-flex;align-items:center;gap:8px;background:var(--glass);border:1px solid rgba(255,255,255,.14);
  border-radius:99px;padding:8px 14px;font-size:13px;backdrop-filter:blur(8px)}
.chip .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green)}
#modeChip{margin-left:auto;color:var(--light);font-weight:700;font-size:12px;letter-spacing:1px;text-transform:uppercase}
.pill{background:rgba(255,255,255,.14);color:#fff;border-radius:99px;padding:8px 14px;font-size:13px;font-weight:700;min-height:36px}
.pill.ghost{background:rgba(255,255,255,.1)}

#hostQuestionWrap{position:absolute;left:50%;top:calc(58px + var(--safe-t));transform:translateX(-50%);
  width:min(92vw,980px);text-align:center;pointer-events:none}
#hostQnum{font-family:'Granika';letter-spacing:3px;font-size:13px;color:var(--green);text-transform:uppercase}
#hostQuestion{font-family:'Granika';font-size:clamp(20px,3.1vw,42px);line-height:1.15;margin-top:6px;
  text-shadow:0 6px 30px rgba(0,0,0,.75),0 2px 6px rgba(0,0,0,.6)}
#hostQuestion::after{content:"";display:block;width:120px;height:4px;border-radius:3px;margin:12px auto 0;background:var(--orange)}

/* --- tableau des réponses (façon Family Feud) --- */
#board{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  display:grid;gap:10px;width:min(88vw,900px);pointer-events:none}
#board .case{display:flex;align-items:center;gap:12px;border-radius:14px;padding:12px 16px;min-height:58px;
  background:linear-gradient(160deg,#12245e,#0C1A4B);border:2px solid rgba(255,255,255,.16);
  box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.2,1.4,.5,1),background .3s}
#board .case .idx{font-family:'DS-Digi';font-size:26px;color:var(--light);min-width:38px}
#board .case .txt{flex:1;font-family:'Granika';font-size:clamp(14px,1.7vw,24px);opacity:0;transition:opacity .3s}
#board .case .pts{font-family:'DS-Digi';font-size:26px;color:var(--gold);opacity:0;transition:opacity .3s}
#board .case.done{background:linear-gradient(160deg,#0aa95a,#00E472);border-color:#7bffb9;color:var(--navy)}
#board .case.done .idx{color:#0C1A4B}
#board .case.done .txt,#board .case.done .pts{opacity:1}
#board .case.miss{background:linear-gradient(160deg,#4b5474,#2b3453);border-color:rgba(255,255,255,.2)}
#board .case.miss .txt,#board .case.miss .pts{opacity:.85}
#board .case.flip{animation:flip .55s cubic-bezier(.3,1.5,.5,1)}
@keyframes flip{0%{transform:rotateX(0) scale(1)}45%{transform:rotateX(90deg) scale(1.06)}100%{transform:rotateX(0) scale(1)}}
#board .case .by{font-size:11px;letter-spacing:1px;text-transform:uppercase;opacity:.8}

/* --- bas de l'écran --- */
#hostBottom{display:flex;align-items:center;gap:18px;padding:0 18px calc(16px + var(--safe-b));
  background:linear-gradient(0deg,rgba(5,11,38,.92),rgba(5,11,38,0))}
#balance{position:relative;flex:1;max-width:520px;height:56px}
#balanceImg{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;opacity:.95}
#balanceMark{position:absolute;top:-6px;width:10px;height:calc(100% + 12px);border-radius:6px;
  background:linear-gradient(180deg,#fff,var(--gold));box-shadow:0 0 16px rgba(255,207,90,.9);
  transition:left .45s cubic-bezier(.3,1.3,.5,1);left:50%}
#balanceLabels{position:absolute;left:0;right:0;bottom:-20px;display:flex;justify-content:space-between;
  font-family:'DS-Digi';font-size:20px}
#balanceLabels span:first-child{color:var(--light)} #balanceLabels span:last-child{color:var(--green)}
#timerWrap{display:flex;align-items:center;gap:8px}
#hourglass{width:34px;height:34px;filter:drop-shadow(0 4px 10px rgba(0,0,0,.6))}
#timer{font-family:'DS-Digi';font-size:44px;line-height:1;min-width:82px;text-align:center}
#timer.low{color:var(--coral);animation:pulse .9s infinite}
@keyframes pulse{50%{opacity:.35}}
#hostBtns{display:flex;gap:10px;margin-left:auto}
#hostBtns button{border-radius:99px;padding:14px 22px;font-size:16px;font-weight:800;
  box-shadow:0 10px 26px rgba(0,0,0,.45)}
#hostBtns .primary{background:var(--green);color:var(--navy)}
#hostBtns .ghost{background:rgba(255,255,255,.14);color:#fff}

/* --- panneaux hôte (lobby / fin) --- */
#hostLobby,#hostEnd{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:min(92vw,560px);background:var(--glass);border:1px solid rgba(255,255,255,.16);border-radius:22px;
  padding:22px;backdrop-filter:blur(14px);box-shadow:var(--shadow);max-height:88vh;overflow:auto}
#hostLobby h2,#hostEnd h2{margin:0 0 12px}
#hostLobby h2 b,#lobbyCode{font-family:'DS-Digi';color:var(--green);letter-spacing:5px;font-size:32px}
.qrbox{text-align:center;margin:10px 0}
.qrbox img{width:150px;height:150px;background:#fff;padding:8px;border-radius:12px}
.join-hint{text-align:center;font-size:12px;opacity:.8;margin-bottom:14px;word-break:break-all}
#lobbyPlayers{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
