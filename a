const randStr = (len) => crypto.randomBytes(len).toString('base64url').slice(0, len).replace(/[-_]/g, 'A');
const randomCode = () => {
  let code = '';
  for (let i = 0; i < CODE_LENGTH; i++) {
    code += CODE_ALPHABET[crypto.randomInt(CODE_ALPHABET.length)];
