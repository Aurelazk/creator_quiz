  function buildStage(scene) {
    // sol circulaire
    const floor = mesh(GEO.circle, mat('#0a1840', { rough: 0.42, metal: 0.3 }), 0, 0, 0, 9.5, 1, 9.5);
    floor.rotation.x = -Math.PI / 2;
