function startGame(room) {
  if (room.players.size < 1) return false;
  room.order = G.pickQuestions(QUESTIONS, G.GAME_Q);
  room.qi = -1;
  room.qTotal = room.order.length;
  room.ranking = null;
  room.lastAwards = null;
  room.paused = false;
  room.pauseLeft = 0;
  room.phase = G.PHASES.LOBBY;
