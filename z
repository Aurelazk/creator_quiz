test('judge : trouvé, doublon, raté', () => {
  const q = {
    answers: [
      { text: 'Pâte rouge (amiwo)', pts: 25, aliases: ['amiwo'] },
      { text: 'Riz au gras', pts: 20, aliases: ['riz gras'] },
    ],
  };
