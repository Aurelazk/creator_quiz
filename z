/* =====================================================================
   css/base.css — reset, polices, fondations CREATOR
   ===================================================================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@font-face {
  font-family: 'Famous College';
  src: url('../assets/fonts/famous-college.ttf') format('truetype');
  font-weight: 400; font-display: swap;
}
@font-face {
  font-family: 'Granika';
  src: url('../assets/fonts/granika.otf') format('opentype');
  font-weight: 400; font-display: swap;
}
@font-face {
  font-family: 'Janda Manatee Solid';
  src: url('../assets/fonts/janda-manatee-solid.ttf') format('truetype');
  font-weight: 400; font-display: swap;
}

html { font-size: 16px; -webkit-tap-highlight-color: transparent; }
body {
  font-family: var(--font-sans);
  color: var(--blanc);
  background: var(--nuit-fonce);
  overflow: hidden;
  min-height: 100dvh;
  touch-action: manipulation;
}
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
input, select { outline: none; }
img { user-select: none; -webkit-user-drag: none; max-width: 100%; }
ol, ul { list-style: none; }
h1, h2, h3 { font-family: var(--font-display); line-height: 1.1; }
h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
h3 { font-size: 1.2rem; }
a { color: var(--bleu2); }

.hidden { display: none !important; }
.w-full { width: 100%; }
.hint { color: rgba(244, 246, 252, 0.55); font-size: 0.85rem; line-height: 1.45; }
.eyebrow {
  font-family: var(--font-display);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: var(--vert);
  margin-bottom: var(--space-2);
}

:focus-visible { outline: 3px solid var(--bleu2); outline-offset: 3px; border-radius: 6px; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}


===== ./css/components.css =====

/* =====================================================================
   css/components.css — composants réutilisables
   ===================================================================== */

/* ---------------- Loader ---------------- */
.loader {
  position: fixed; inset: 0; z-index: 500;
  display: grid; place-items: center;
  background: radial-gradient(circle at 50% 28%, #142a6b 0%, #081033 62%, #050b26 100%);
  transition: opacity 0.45s ease;
}
.loader.done { opacity: 0; pointer-events: none; }
.loader-card { width: min(86vw, 430px); text-align: center; }
.loader-logo {
  font-family: var(--font-display);
  font-size: clamp(3rem, 9vw, 5rem);
  letter-spacing: 0.03em;
  color: var(--blanc);
  line-height: 1;
}
.loader-logo span { color: var(--vert); }
.loader-sub {
  font-family: var(--font-display);
  letter-spacing: 0.45em;
  color: var(--bleu2);
  font-size: clamp(0.65rem, 2vw, 0.9rem);
  margin: 0.6rem 0 2rem;
}
.loader-bar { height: 10px; border-radius: 99px; background: rgba(255,255,255,0.12); overflow: hidden; }
.loader-bar i {
  display: block; height: 100%; width: 0%;
  background: linear-gradient(90deg, var(--vert), var(--bleu2));
  border-radius: 99px; transition: width 0.3s ease;
}
.loader-txt { margin-top: 0.8rem; font-size: 0.8rem; color: rgba(255,255,255,0.55); }

/* ---------------- Boutons ---------------- */
.btn {
  --btn-bg: rgba(255,255,255,0.12);
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  min-height: 46px;
  padding: 0.75rem 1.3rem;
  border-radius: var(--r-full);
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  color: var(--blanc);
  background: var(--btn-bg);
  border: 2px solid transparent;
  transition: transform var(--trans-fast), background var(--trans-fast), box-shadow var(--trans-fast);
  user-select: none;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(1px) scale(0.99); }
.btn[disabled] { opacity: 0.4; pointer-events: none; }
.btn--primary {
  background: linear-gradient(135deg, var(--vert), #00c261);
  color: var(--nuit-fonce);
  box-shadow: 0 8px 24px rgba(0, 228, 114, 0.28);
}
.btn--primary:hover { box-shadow: 0 10px 32px rgba(0, 228, 114, 0.4); }
.btn--secondary {
  background: linear-gradient(135deg, var(--bleu), var(--bleu2));
  color: var(--blanc);
  box-shadow: 0 8px 24px rgba(11, 53, 254, 0.35);
}
.btn--danger {
  background: linear-gradient(135deg, var(--orange), #d93a10);
  color: var(--blanc);
  box-shadow: 0 8px 20px rgba(255, 78, 32, 0.3);
}
.btn--ghost {
  background: rgba(255,255,255,0.09);
  border-color: rgba(255,255,255,0.16);
}
.btn--ghost:hover { background: rgba(255,255,255,0.16); }
.btn--xl { min-height: 58px; font-size: 1.15rem; padding: 1rem 1.6rem; }
.btn--sm { min-height: 38px; font-size: 0.82rem; padding: 0.5rem 0.9rem; }

.icon-btn {
  width: 44px; height: 44px; border-radius: 50%;
  display: inline-grid; place-items: center;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.16);
  font-size: 1.1rem; transition: background var(--trans-fast), transform var(--trans-fast);
}
.icon-btn:hover { background: rgba(255,255,255,0.18); }
.icon-btn:active { transform: scale(0.94); }
.icon-btn--sm { width: auto; height: 36px; padding: 0 0.8rem; border-radius: var(--r-full); font-size: 0.78rem; }

.link-btn {
  color: rgba(244,246,252,0.72);
  font-size: 0.86rem;
  padding: 0.45rem 0.2rem;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--trans-fast);
}
.link-btn:hover { color: var(--vert); }

/* ---------------- Champs ---------------- */
.field { display: flex; flex-direction: column; gap: 0.4rem; }
.field > span {
  font-family: var(--font-display);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: rgba(244,246,252,0.62);
}
.input {
  width: 100%;
  min-height: 52px;
  padding: 0.85rem 1rem;
  border-radius: var(--r-md);
  border: 2px solid rgba(255,255,255,0.16);
  background: rgba(5, 11, 38, 0.55);
  color: var(--blanc);
  font-size: 1.05rem;
  transition: border-color var(--trans-fast), background var(--trans-fast);
}
.input::placeholder { color: rgba(244,246,252,0.32); }
.input:focus { border-color: var(--bleu2); background: rgba(5,11,38,0.8); }
.input--code {
  text-transform: uppercase;
  letter-spacing: 0.35em;
  text-align: center;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
}

/* ---------------- Cartes / panneaux ---------------- */
.modal {
  position: absolute; inset: 0; z-index: 60;
  display: grid; place-items: center;
  padding: 1.25rem;
  background: rgba(4, 8, 28, 0.7);
  backdrop-filter: blur(9px);
  animation: fadeIn 0.22s ease;
}
.modal-card {
  width: min(92vw, 580px);
  max-height: 92vh;
  overflow: auto;
  background: linear-gradient(165deg, rgba(20, 38, 100, 0.96), rgba(8, 16, 51, 0.98));
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: var(--r-xl);
  padding: clamp(1.2rem, 3vw, 2rem);
  box-shadow: var(--shadow-xl);
}
.modal-card h2 { color: var(--blanc); margin-bottom: 0.4rem; }

/* -------- lobby animateur : panneau latéral, pas de recouvrement -------- */
#hostLobby {
  position: absolute; top: 0; right: 0; bottom: 0; z-index: 60;
  width: min(42vw, 460px);
  display: flex; align-items: flex-start;
  padding: 1rem;
  background: rgba(4, 8, 28, 0.82);
  backdrop-filter: blur(6px);
  border-left: 1px solid rgba(255,255,255,0.1);
  overflow-y: auto;
  animation: none;
}
#hostLobby .lobby-card {
  width: 100%; max-height: none; overflow: visible;
  padding: 1.2rem 1rem;
  box-shadow: none; border: none; background: transparent;
}
#hostLobby .lobby-qr img { width: 320px; height: 320px; }
#hostLobby .btn--xl { width: 100%; }
.panel, .panel { width: 100%; }
.panel {
  width: 100%;
  background: linear-gradient(165deg, rgba(20, 38, 100, 0.88), rgba(8, 16, 51, 0.95));
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: var(--r-xl);
  padding: 1.1rem;
  box-shadow: var(--shadow-lg);
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.code-big {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3rem);
  letter-spacing: 0.25em;
  color: var(--vert);
  text-shadow: 0 0 30px rgba(0,228,114,0.4);
}
.join-url {
  font-size: 0.78rem;
  color: rgba(244,246,252,0.55);
  word-break: break-all;
  font-family: var(--font-mono);
}

/* ---------------- Classements ---------------- */
.rank-list { display: flex; flex-direction: column; gap: 0.35rem; margin: 1rem 0; }
.rank-item {
  display: flex; align-items: center; gap: 0.7rem;
  padding: 0.65rem 0.8rem;
  border-radius: var(--r-md);
  background: rgba(255,255,255,0.05);
  border: 1px solid transparent;
  font-size: 1rem;
}
.rank-item .rank-pos {
  width: 2rem; text-align: center;
  font-family: var(--font-display); font-size: 1.2rem; color: var(--bleu2);
}
.rank-item .rank-avatar { width: 34px; height: 34px; border-radius: 50%; overflow: hidden; background: rgba(255,255,255,0.08); flex: none; }
.rank-item .rank-avatar svg { width: 100%; height: 100%; }
.rank-item .rank-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-item .rank-score { font-family: var(--font-display); font-size: 1.15rem; color: var(--vert); }
.rank-item.win { background: linear-gradient(90deg, rgba(255,207,90,0.18), rgba(255,207,90,0.02)); border-color: rgba(255,207,90,0.4); }
.rank-item.win .rank-pos, .rank-item.win .rank-score { color: var(--gold); }
.rank-item.me { border-color: rgba(46,133,255,0.6); background: rgba(46,133,255,0.12); }
.winner-line { color: var(--gold); font-size: 1rem; margin: 0.3rem 0 0.6rem; min-height: 1.2rem; }
.winner-line b { color: var(--blanc); }
.end-title { font-family: var(--font-display); color: var(--blanc); }
