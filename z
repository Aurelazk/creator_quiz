    on($('#btnQr'), 'click', () => { updateRoomChrome(); openModal('#qrModal'); });
    on($('#btnQrClose'), 'click', () => closeModal('#qrModal'));
    on($('#btnHostRetry'), 'click', () => Net.connect());
    on($('#btnPhoneRetry'), 'click', () => Net.connect());
