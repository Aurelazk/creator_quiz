      const hood = addPart(body, sphere, mat(AvatarShade(c.jacket, -10), { rough: 0.55 }), 0, torsoY + 0.42, -0.12, 0.32, 0.12, 0.24);
      hood.name = 'hood';
      [-0.09, 0.09].forEach((x) => {
